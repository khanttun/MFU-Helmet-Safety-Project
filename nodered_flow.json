  {
    "id": "ui_gate",
    "type": "ui_template",
    "z": "tab1",
    "group": "ui_grp1",
    "name": "Gate card",
    "order": 1,
    "width": "6",
    "height": "11",
    "format": "<style>\n.hg{font-family:'Segoe UI',Roboto,sans-serif;color:#fff;border-radius:18px;padding:18px 20px;\n  background:linear-gradient(145deg,#1e293b,#0f172a);box-shadow:0 8px 24px rgba(0,0,0,.35);transition:box-shadow .5s}\n.hg.safe{box-shadow:0 0 28px rgba(34,197,94,.45)}.hg.viol{box-shadow:0 0 28px rgba(239,68,68,.5)}\n.hg-top{display:flex;justify-content:space-between;align-items:center;font-size:15px;opacity:.9}\n.chip{padding:4px 12px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:1px;background:#475569;transition:background .4s}\n.chip.open{background:#16a34a}.chip.closed{background:#dc2626}\n.hg-state{text-align:center;font-size:36px;font-weight:800;letter-spacing:3px;margin:10px 0 2px;color:#94a3b8;transition:color .4s}\n.safe .hg-state{color:#4ade80}.viol .hg-state{color:#f87171}\n.bar{height:6px;border-radius:3px;background:rgba(255,255,255,.1);overflow:hidden;margin:6px 0 4px}\n.fill{height:100%;background:#38bdf8;transition:width .5s}\n.conf{text-align:center;font-size:12px;opacity:.65;margin-bottom:6px}\n.arm{transform-origin:70px 112px;transition:transform .9s cubic-bezier(.6,-.2,.3,1.3)}\n.hg.b-open .arm{transform:rotate(-65deg)}\n.lamp{fill:#64748b;transition:fill .4s}.hg.b-open .lamp{fill:#22c55e}.hg.b-closed .lamp{fill:#ef4444}\n.tiles{display:flex;gap:12px;margin:8px 0 12px}\n.tile{flex:1;text-align:center;border-radius:14px;padding:10px 6px;background:rgba(255,255,255,.06)}\n.tile .n{font-size:34px;font-weight:800;line-height:1.1}.tile .l{font-size:11px;letter-spacing:1.5px;opacity:.7}\n.tile.s .n{color:#4ade80}.tile.v .n{color:#f87171}\n.hist{border-top:1px solid rgba(255,255,255,.12);padding-top:8px;font-size:12px}\n.hist div{display:flex;justify-content:space-between;padding:3px 0;opacity:.85}\n.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px}\n.dot.SAFE{background:#22c55e}.dot.VIOLATION{background:#ef4444}\n</style>\n<div class=\"hg\" ng-class=\"[cls, 'b-'+bcls]\">\n  <div class=\"hg-top\"><span>&#127949; MFU Helmet Gate</span><span class=\"chip\" ng-class=\"bcls\">BARRIER: {{barrier}}</span></div>\n  <div class=\"hg-state\">{{status}}</div>\n  <div class=\"bar\"><div class=\"fill\" ng-style=\"{width: pct + '%'}\"></div></div>\n  <div class=\"conf\">Confidence {{pct}}% &nbsp;&bull;&nbsp; Last event {{time}}</div>\n  <svg viewBox=\"0 0 300 150\" width=\"100%\">\n    <rect x=\"0\" y=\"130\" width=\"300\" height=\"6\" rx=\"3\" fill=\"#334155\"/>\n    <rect x=\"52\" y=\"100\" width=\"36\" height=\"30\" rx=\"6\" fill=\"#475569\"/>\n    <circle class=\"lamp\" cx=\"70\" cy=\"92\" r=\"7\"/>\n    <g class=\"arm\">\n      <rect x=\"70\" y=\"106\" width=\"200\" height=\"12\" rx=\"6\" fill=\"#f8fafc\"/>\n      <rect x=\"110\" y=\"106\" width=\"22\" height=\"12\" fill=\"#ef4444\"/><rect x=\"154\" y=\"106\" width=\"22\" height=\"12\" fill=\"#ef4444\"/>\n      <rect x=\"198\" y=\"106\" width=\"22\" height=\"12\" fill=\"#ef4444\"/><rect x=\"242\" y=\"106\" width=\"22\" height=\"12\" fill=\"#ef4444\"/>\n    </g>\n  </svg>\n  <div class=\"tiles\">\n    <div class=\"tile s\"><div class=\"n\">{{safe}}</div><div class=\"l\">SAFE</div></div>\n    <div class=\"tile v\"><div class=\"n\">{{violations}}</div><div class=\"l\">VIOLATIONS</div></div>\n  </div>\n  <div class=\"hist\" ng-if=\"history.length\">\n    <div ng-repeat=\"h in history track by $index\"><span><span class=\"dot {{h.status}}\"></span>{{h.status}}</span><span>{{h.time}}</span></div>\n  </div>\n</div>\n<script>\n(function(scope){\n  scope.status='IDLE'; scope.barrier='--'; scope.safe=0; scope.violations=0; scope.time='--';\n  scope.pct=0; scope.history=[]; scope.cls=''; scope.bcls='';\n  scope.$watch('msg', function(msg){\n    if(!msg || !msg.payload) return;\n    var d = msg.payload;\n    scope.status = d.status || 'IDLE';\n    scope.barrier = d.barrier || '--';\n    scope.safe = d.safe || 0;\n    scope.violations = d.violations || 0;\n    scope.time = d.time || '--';\n    scope.pct = Math.round((d.confidence || 0) * 1000) / 10;\n    scope.history = d.history || [];\n    scope.cls = scope.status === 'SAFE' ? 'safe' : scope.status === 'VIOLATION' ? 'viol' : '';\n    var b = String(scope.barrier).toUpperCase();\n    scope.bcls = b === 'OPEN' ? 'open' : b === 'CLOSED' ? 'closed' : '';\n  });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
