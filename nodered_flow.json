  {
    "id": "ui_cam",
    "type": "ui_template",
    "z": "tab1",
    "group": "ui_grp_cam",
    "name": "Webcam view",
    "order": 1,
    "width": "6",
    "height": "8",
    "format": "<style>\n.cam{font-family:'Segoe UI',Roboto,sans-serif;color:#fff;border-radius:18px;padding:14px;\n  background:linear-gradient(145deg,#1e293b,#0f172a);box-shadow:0 8px 24px rgba(0,0,0,.35)}\n.cam-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-size:15px;opacity:.9}\n.live{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:1.5px}\n.live i{width:9px;height:9px;border-radius:50%;background:#ef4444;animation:blink 1.2s infinite}\n@keyframes blink{50%{opacity:.25}}\n.cam-f{position:relative;border-radius:12px;overflow:hidden;background:#000;aspect-ratio:4/3}\n.cam-f img{width:100%;height:100%;object-fit:contain;display:none}\n.cam-off{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:13px;opacity:.7;padding:20px}\n</style>\n<div class=\"cam\">\n  <div class=\"cam-h\"><span>&#128249; Live Detection</span><span class=\"live\"><i></i>LIVE</span></div>\n  <div class=\"cam-f\">\n    <img id=\"helmet-cam-img\" alt=\"camera\">\n    <div class=\"cam-off\" id=\"helmet-cam-off\">Waiting for camera stream...<br>Run helmet_detect.py</div>\n  </div>\n</div>\n<script>\n(function(){\n  // Python and Node-RED on the same PC: leave as is. Different PC: put the Python PC's IP here.\n  var url = 'http://' + location.hostname + ':5000/video_feed';\n  function start(){\n    var img = document.getElementById('helmet-cam-img'), off = document.getElementById('helmet-cam-off');\n    if(!img){ return setTimeout(start, 300); }\n    img.onload  = function(){ img.style.display='block'; off.style.display='none'; };\n    img.onerror = function(){ img.style.display='none'; off.style.display='flex';\n                              setTimeout(function(){ img.src = url + '?t=' + Date.now(); }, 3000); };\n    img.src = url;\n  }\n  start();\n})();\n</script>",
