  {
    "id": "fn_barrier",
    "type": "function",
    "z": "tab1",
    "name": "Barrier state",
    "func": "const b = String(msg.payload).toUpperCase().trim();\nflow.set('barrier', b);\nconst last = flow.get('last') || { status: 'IDLE', conf: 0, time: '--' };\nreturn { payload: { status: last.status, confidence: last.conf, barrier: b,\n                    safe: flow.get('safe') || 0, violations: flow.get('viol') || 0,\n                    time: last.time, history: flow.get('history') || [] } };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 260,
    "wires": [
      [
        "ui_gate"
      ]
    ]
  },
  {
    "id": "fn_decide",
    "type": "function",
    "z": "tab1",
    "name": "Decision logic",
    "func": "const e = msg.payload;\nif (!e || !e.status) { return null; }\nconst status = e.status;\nconst conf = Number(e.confidence || 0);\nlet safe = flow.get('safe') || 0;\nlet viol = flow.get('viol') || 0;\nlet history = flow.get('history') || [];\nconst time = new Date().toLocaleTimeString('en-GB');\nlet cmdMsg = null, dbMsg = null;\n\nif (status === 'VIOLATION') {\n    viol++;\n    cmdMsg = { topic: 'mfu-helmet-6731502018/cmd', payload: 'CLOSE', qos: 1 };\n    dbMsg = { params: { $ts: e.timestamp, $status: status, $conf: conf, $image: e.image || '', $cmd: 'CLOSE' } };\n} else if (status === 'SAFE') {\n    safe++;\n    cmdMsg = { topic: 'mfu-helmet-6731502018/cmd', payload: 'OPEN', qos: 1 };\n}   // NONE -> no command, barrier keeps its last state\n\nif (status !== 'NONE') {\n    history.unshift({ status: status, time: time });\n    history = history.slice(0, 5);\n}\nflow.set('safe', safe); flow.set('viol', viol); flow.set('history', history);\nconst shown = (status === 'NONE' ? 'IDLE' : status);\nflow.set('last', { status: shown, conf: conf, time: time });\n\nconst uiMsg = { payload: { status: shown, confidence: conf, barrier: flow.get('barrier') || '--',\n                           safe: safe, violations: viol, time: time, history: history } };\nreturn [cmdMsg, uiMsg, dbMsg];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 120,
    "wires": [
      [
        "out_cmd"
      ],
      [
        "ui_gate"
      ],
      [
        "db_insert"
      ]
    ]
