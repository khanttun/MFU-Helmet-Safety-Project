  {
    "id": "fn_load",
    "type": "function",
    "z": "tab1",
    "name": "Load totals",
    "func": "const rows = Array.isArray(msg.payload) ? msg.payload : [];\nconst n = rows.length ? Number(rows[0].n) || 0 : 0;\nflow.set('viol', n);   // violation total survives restarts because it is read from the DB\nconst last = flow.get('last') || { status: 'IDLE', conf: 0, time: '--' };\nreturn { payload: { status: last.status, confidence: last.conf, barrier: flow.get('barrier') || '--',\n                    safe: flow.get('safe') || 0, violations: n,\n                    time: last.time, history: flow.get('history') || [] } };",
